  <vhdl appearance="logisim_evolution" name="d_latch">library ieee;
use ieee.std_logic_1164.all;

entity d_latch is
    port (d, en : in std_logic;
          q : out std_logic);
end entity d_latch;

architecture rtl of d_latch is
begin
    process(d, en)
    begin
        if en = '1' then
            q &lt;= d;
        end if;
    end process;
end architecture rtl;
</vhdl>
