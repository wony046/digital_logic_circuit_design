  <vhdl appearance="logisim_evolution" name="rs_latch">library ieee;
use ieee.std_logic_1164.all;

entity rs_latch is
    port (s, r : in std_logic;
          q, qbar : out std_logic);
end entity rs_latch;

architecture rtl of rs_latch is
    signal q_i, qbar_i : std_logic;
begin
    q_i &lt;= not (r or qbar_i);
    qbar_i &lt;= not (s or q_i);
    q &lt;= q_i;
    qbar &lt;= qbar_i;
end architecture rtl;
</vhdl>
