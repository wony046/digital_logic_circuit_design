  <vhdl appearance="logisim_evolution" name="vote25">library ieee;
use ieee.std_logic_1164.all;

entity vote25 is
    port (
        vt     : in  std_logic_vector(24 downto 0);
        result : out std_logic
    );
end entity vote25;

architecture behavioral of vote25 is
begin
    process(vt)
        variable count : integer range 0 to 25;
    begin
        count := 0;
        for i in vt'range loop
            if vt(i) = '1' then
                count := count + 1;
            end if;
        end loop;

        if count &gt;= 13 then
            result &lt;= '1';
        else
            result &lt;= '0';
        end if;
    end process;
end architecture behavioral;
</vhdl>
