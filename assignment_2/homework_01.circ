  <vhdl appearance="logisim_evolution" name="logic4">library ieee;
use ieee.std_logic_1164.all;

entity logic4 is
    port (
        a    : in  std_logic;
        b    : in  std_logic;
        c    : in  std_logic;
        d    : in  std_logic;
        out1 : out std_logic;
        out2 : out std_logic
    );
end entity logic4;

architecture behavioral of logic4 is
begin
    out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end architecture behavioral;
